{
  "version": 2,
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug (Ninja)",
      "description": "Debug 构建，开启 CLI、测试和 bench。",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LOOMLOG_BUILD_CLI": "ON",
        "LOOMLOG_BUILD_TESTS": "ON",
        "LOOMLOG_BUILD_BENCH": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release (Ninja)",
      "description": "Release 构建，开启 CLI、测试和 bench。",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "LOOMLOG_BUILD_CLI": "ON",
        "LOOMLOG_BUILD_TESTS": "ON",
        "LOOMLOG_BUILD_BENCH": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" }
  ]
}
